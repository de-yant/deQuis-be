# ===== deQuis Environment =====

# Port API lokal (server/ Express)
PORT=3001

# Database
#   Lokal  : sqlite (file data/dequis.db dibuat otomatis)
#   Vercel : postgres://... (Neon PostgreSQL) — dipakai saat fase production
DATABASE_URL=sqlite://data/dequis.db

# JWT secret untuk session/token guru
JWT_SECRET=change_this_secret_in_production

# Frontend origin (untuk CORS)
CORS_ORIGIN=http://localhost:5173
