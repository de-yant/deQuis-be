{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": false,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["node"],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "server/index.ts",
    "api/index.ts",
    "server/db.ts",
    "server/schema.ts",
    "server/auth/password.ts",
    "server/auth/token.ts",
    "drizzle.config.ts"
  ],
  "exclude": ["node_modules", "dist", "db/seed.ts", "server/api", "server/services"]
}