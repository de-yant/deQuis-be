{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noImplicitThis": false,
    "strictFunctionTypes": false,
    "strictBindCallApply": false,
    "strictPropertyInitialization": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": false,
    "noUncheckedIndexedAccess": false,
    "noPropertyAccessFromIndexSignature": false,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["server", "db", "api", "drizzle.config.ts"],
  "exclude": ["db/seed.ts", "server/services/gamification.ts", "server/services/roadmap.ts", "server/api/admin.ts", "server/api/ranking.ts", "server/api/student.ts", "server/services/auth-guard.ts", "server/services/gamification.ts"]
}