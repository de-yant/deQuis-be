{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "echo 'Using pre-built dist'",
  "outputDirectory": "dist",
  "installCommand": "echo 'skip install'",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": ["server/**", "drizzle.config.ts", "drizzle.pg.config.ts", "package.json"]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" }
  ]
}
